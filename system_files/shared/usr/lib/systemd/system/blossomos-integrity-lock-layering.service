[Unit]
Description=Lock rpm-ostree layering while BlossomOS integrity mode is on
Documentation=https://dev.blossomos.org/blossom/os/core/image/-/blob/release/docs/INTEGRITY.md
ConditionKernelCommandLine=blossomos.integrity=1
DefaultDependencies=no
After=local-fs.target
Before=rpm-ostreed.service sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/blossomos-integrity lock-layering true

[Install]
WantedBy=sysinit.target
