[Unit]
Description=BlossomOS Boot Splash Message
DefaultDependencies=no
After=plymouth-start.service
Before=sysinit.target
ConditionPathExists=/usr/bin/plymouth

[Service]
# Keeps the text on the splash until Plymouth quits, see the script
Type=simple
ExecStart=/usr/libexec/blossomos-plymouth-status daemon

[Install]
WantedBy=sysinit.target
