#!/usr/bin/bash
set -u

STATE=/etc/blossomos/brcmfmac43602
TEMPLATES=/usr/share/blossomos/brcmfmac43602
RUNTIME=/run/blossomos-brcmfmac43602
FIRMWARE=/run/blossomos-firmware

found=
for dev in /sys/bus/pci/devices/*; do
    [[ "$(cat "$dev/vendor" 2>/dev/null)" == 0x14e4 && "$(cat "$dev/device" 2>/dev/null)" == 0x43ba ]] && found=1 && break
done
[[ -n "$found" ]] || exit 0

mkdir -p "$RUNTIME"
echo "feature_disable=0" > "$RUNTIME/options"

template=$(cat "$STATE/template" 2>/dev/null || echo bootcamp)
echo "$template" > "$RUNTIME/template"
[[ "$template" == none ]] && exit 0
[[ -r "$TEMPLATES/$template.txt" ]] || template=bootcamp

mac=$(tr 'A-F' 'a-f' < /etc/blossomos/wifi-macaddr 2>/dev/null | tr -d '[:space:]')
if ! [[ "$mac" =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]] || [[ "$mac" == 00:00:00:00:00:00 ]]; then
    mac=$(sha256sum /etc/machine-id 2>/dev/null | sed -E 's/^(..)(..)(..)(..)(..).*/02:\1:\2:\3:\4:\5/')
fi
[[ "$mac" =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]] || exit 0

mkdir -p "$FIRMWARE/brcm"
sed "s/^macaddr=.*/macaddr=$mac/" "$TEMPLATES/$template.txt" > "$FIRMWARE/brcm/brcmfmac43602-pcie.txt"
echo -n "$FIRMWARE" > /sys/module/firmware_class/parameters/path
exit 0
