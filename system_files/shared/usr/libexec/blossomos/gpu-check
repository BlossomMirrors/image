#!/usr/bin/bash
set -euo pipefail

IMAGE_INFO="/usr/share/ublue-os/image-info.json"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/blossomos"
DISMISS_FILE="$STATE_DIR/gpu-check-dismissed"
LANG_DIR="/usr/libexec/blossomos/lang"
TITLE="BlossomOS"

command -v kdialog &>/dev/null || exit 0
[[ -r "$IMAGE_INFO" ]] || exit 0

locale="${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}}"
locale="${locale%%:*}"
locale="${locale%%[_.@]*}"
LANG_FILE="$LANG_DIR/$locale.json"
[[ -r "$LANG_FILE" ]] || LANG_FILE="$LANG_DIR/en.json"

t() {
    local key=$1
    shift
    jq -nr --arg k "$key" \
        --slurpfile l "$LANG_FILE" --slurpfile f "$LANG_DIR/en.json" '
        ($k | split(".")) as $p
        | ($l[0] | getpath($p)) // ($f[0] | getpath($p)) // $k
        | reduce ($ARGS.positional[] | capture("^(?<n>[^=]+)=(?<v>.*)$"; "s")) as $a
            (.; split("{" + $a.n + "}") | join($a.v))' --args "$@"
}

