#!/usr/bin/bash
set -u

STATE=/etc/blossomos/brcmfmac43602
RUNTIME=/run/blossomos-brcmfmac43602
VARIANTS=("none|" "none|feature_disable=0" "bootcamp|feature_disable=0" "ratcliffe|feature_disable=0")

[[ -f "$RUNTIME/chip" ]] || exit 0
[[ -f "$STATE/confirmed" || -f "$STATE/exhausted" ]] && exit 0
mkdir -p "$STATE"

connected() {
    nmcli -t -f TYPE,STATE device 2>/dev/null | grep -qx 'wifi:connected'
}

wait_connected() {
    for _ in $(seq "$1"); do
        connected && return 0
        sleep 2
    done
    return 1
}

known_network_in_range() {
    local visible name type ssid
    visible=$(nmcli -t -f SSID device wifi list --rescan yes 2>/dev/null)
    while IFS=: read -r name type; do
        [[ "$type" == 802-11-wireless ]] || continue
        ssid=$(nmcli -g 802-11-wireless.ssid connection show id "$name" 2>/dev/null)
        [[ -n "$ssid" ]] && grep -qxF "$ssid" <<< "$visible" && return 0
    done < <(nmcli -t -f NAME,TYPE connection show 2>/dev/null)
    return 1
}

use() {
    echo "${1%%|*}" > "$STATE/template"
    echo "${1#*|}" > "$STATE/options"
}

reload_driver() {
    systemctl stop NetworkManager
    for module in brcmfmac_wcc brcmfmac_bca brcmfmac_cyw brcmfmac; do
        grep -q "^$module " /proc/modules && rmmod "$module"
    done
    modprobe brcmfmac
    sleep 3
    systemctl start NetworkManager
}

current="$(cat "$RUNTIME/template" 2>/dev/null || echo none)|$(cat "$RUNTIME/options" 2>/dev/null)"
if wait_connected 45; then
    use "$current"
    touch "$STATE/confirmed"
    echo "brcmfmac43602: connected with $current"
    exit 0
fi
known_network_in_range || { echo "brcmfmac43602: no saved network in range, nothing to judge"; exit 0; }

for variant in "${VARIANTS[@]}"; do
    [[ "$variant" == "$current" ]] && continue
    echo "brcmfmac43602: no connection with $current, trying $variant"
    use "$variant"
    reload_driver
    current=$variant
    if wait_connected 60; then
        touch "$STATE/confirmed"
        echo "brcmfmac43602: connected with $variant"
        exit 0
    fi
done

use "${VARIANTS[0]}"
touch "$STATE/exhausted"
echo "brcmfmac43602: no variant connected, back to the plain driver"
reload_driver
exit 0
