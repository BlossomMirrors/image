#!/usr/bin/bash
set -euo pipefail

SCOPE="$1"

# Fix apps crashing with BlossomUI applied
flatpak override "${SCOPE}" \
    --env=QML2_IMPORT_PATH=/app/lib/qml:/usr/share/runtime/lib/plugins/BlossomUI/lib/qml

# Signal only supports the GNOME libsecret keyring out of the box. BlossomOS ships KDE, so point it at KWallet 6 instead.
flatpak override "${SCOPE}" \
    --env=SIGNAL_PASSWORD_STORE=kwallet6 org.signal.Signal

# fontconfig host font fixes for Flatpaks
flatpak override "${SCOPE}" --filesystem=xdg-config/fontconfig:ro

if [[ "${SCOPE}" == "--user" ]]; then
    conf_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/fontconfig/conf.d"
    conf="${conf_dir}/90-blossomos-flatpak-host-fonts.conf"
    mkdir -p "${conf_dir}"
    {
        echo '<?xml version="1.0"?>'
        echo '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">'
        echo '<!-- Generated by /usr/libexec/blossomos-flatpak-overrides, do not edit. -->'
        echo '<fontconfig>'
        for dir in /usr/share/fonts/*/; do
            echo "  <dir>/run/host/fonts/$(basename "${dir}")</dir>"
        done
        echo '</fontconfig>'
    } > "${conf}.tmp"
    mv "${conf}.tmp" "${conf}"
    stamp_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/blossomos"
    stamp="${stamp_dir}/flatpak-fonts.sha256"
    fonts_hash="$(find /usr/share/fonts -type f | sort | sha256sum | cut -d' ' -f1)"
    if [[ "$(cat "${stamp}" 2>/dev/null)" != "${fonts_hash}" ]]; then
        rm -rf "${HOME}"/.var/app/*/cache/fontconfig
        mkdir -p "${stamp_dir}"
        echo "${fonts_hash}" > "${stamp}"
    fi
fi
