<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>BlossomOS</vendor>
  <action id="org.blossomos.gpu-switch">
    <description>Switch the system image to match the GPU</description>
    <description xml:lang="de">System-Image passend zur Grafikkarte wechseln</description>
    <message>Authentication is required to switch the system image to match your GPU</message>
    <message xml:lang="de">Zum Wechseln des System-Images passend zu deiner Grafikkarte ist eine Authentifizierung erforderlich</message>
    <icon_name>video-display</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/blossomos/gpu-switch</annotate>
  </action>
</policyconfig>
